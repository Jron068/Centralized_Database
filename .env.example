# Copy this file to .env and add your own values.
FLASK_SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=1

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=centralized_database

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
# Use your Gmail address and a Google App Password (not your Gmail password).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Required for resort photo uploads. Flagged images and scan failures are rejected.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
