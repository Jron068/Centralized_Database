# Copy this file to .env and add your own values.
FLASK_SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=1

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=centralized_database

# Set DATABASE_URL for Supabase PostgreSQL. Leave blank for local MySQL settings above.
DATABASE_URL=

# Required for persistent file uploads on free hosting.
SUPABASE_URL=
SUPABASE_STORAGE_SERVICE_ROLE_KEY=
# Create a public resort-media bucket and a private payment-proofs bucket in Supabase Storage.
SUPABASE_PUBLIC_STORAGE_BUCKET=resort-media
SUPABASE_PRIVATE_STORAGE_BUCKET=payment-proofs

# Gmail API OAuth client credentials. Create a Google OAuth client and grant:
# https://www.googleapis.com/auth/gmail.send
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
MAIL_DEFAULT_SENDER=
# Used only for local FLASK_DEBUG=1 email testing.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=

# Required for resort photo uploads. Flagged images and scan failures are rejected.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
